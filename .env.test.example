# Copiez ce fichier en .env.test (jamais commité, voir .gitignore) et
# remplissez les valeurs avant de lancer les tests E2E : npm run test:e2e
#
# Utilisez de préférence un projet Supabase de test/dev, pas votre projet de
# production : les tests créent de vraies parties et de vrais comptes.

# URL où l'appli tourne pendant les tests. Si absent, Playwright lance
# automatiquement `npm run dev` sur http://localhost:5173 et attend qu'il
# soit prêt.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Mêmes valeurs que dans votre .env (Project Settings → API sur Supabase).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé "service_role" (PAS la clé anon) — Project Settings → API → service_role.
# Sert UNIQUEMENT, en local, à créer/confirmer automatiquement les comptes
# de test (contourne la validation par email). Ne jamais exposer cette clé
# côté client, ne jamais la commiter.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe utilisé pour tous les comptes de test créés automatiquement.
TEST_USER_PASSWORD=TestPassword123!
